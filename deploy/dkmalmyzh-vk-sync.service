[Unit]
# Импорт записей из сообществ ВК домов культуры района.
#
# Не отдельный процесс с payload CLI, а локальный запрос к уже работающему
# сайту: на прод едет standalone-бандл, CLI в него не входит (см. README
# миграций), а фото надо писать в постоянный каталог Media, который есть только
# на этом боксе. Приложение и так подключено к БД и к Media — второй рантайм
# ради импорта везти незачем.
#
# В ВК ходим ТОЛЬКО через шлюз SARAFAN (проект setka, pool #062): свой VK-токен
# держать нельзя — VK привязывает его к IP выпуска, и раздача credential
# технически не работает. Нужны SARAFAN_GATEWAY_URL и SARAFAN_GATEWAY_KEY.
#
# Секреты (ключ шлюза, INTERNAL_OPS_SECRET) берутся из того же EnvironmentFile, что и
# остальные значения сайта. В репозитории их нет.
Description=Импорт записей из ВКонтакте для портала культуры Малмыжского района
After=network-online.target dkmalmyzh.service
Requires=dkmalmyzh.service

[Service]
Type=oneshot
User=valstan
EnvironmentFile=/etc/dkmalmyzh/dkmalmyzh.env

# --fail: HTTP 4xx/5xx должны валить юнит, иначе «не настроено» и «нет доступа»
# выглядели бы в журнале как успешный прогон.
# Запуск идёт через обёртку, а не голым curl. Причина: `curl --fail` по
# определению НЕ печатает тело при HTTP-ошибке, поэтому 409 «прогон уже идёт» и
# 503 «маршрут выключен» выглядели в журнале одинаково — `curl: (22) ... 409`
# без единого слова приложения, а юнит уходил в failed. Обёртка печатает код и
# тело, считает 409 нормой (замок держит идущий прогон) и падает только на
# настоящих отказах.
#
# --max-time внутри обёртки заведомо меньше интервала таймера: прогон, который
# не уложился, должен закончиться до следующего запуска, а не копиться.
ExecStart=/usr/local/bin/dkmalmyzh-vk-sync-run.sh

TimeoutStartSec=1800

# Импорт — фоновая работа: посетитель сайта важнее, а vCPU на боксе один.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
