[Unit]
Description=Периодический импорт записей из ВКонтакте (портал культуры)

[Timer]
# Раз в полчаса. Чаще смысла нет: сельские ДК публикуют по нескольку записей в
# неделю, а лимит сервисного токена ВК — 3 запроса в секунду на всё приложение.
OnCalendar=*:0/30

# Разброс, чтобы прогон не приходился ровно на круглое время: у соседей на этом
# же боксе свои задания по расписанию, и одновременный старт бьёт по
# единственному vCPU.
RandomizedDelaySec=300

# Пропущенный из-за перезагрузки прогон догоняется, а не теряется.
Persistent=true

# Первый запуск не в момент старта системы: приложению нужно подняться.
OnBootSec=10min

[Install]
WantedBy=timers.target
