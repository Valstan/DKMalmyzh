[Unit]
Description=Периодический импорт записей из ВКонтакте (портал культуры)

[Timer]
# Раз в полчаса. Чаще смысла нет: сельские ДК публикуют по нескольку записей в
# неделю, а лимит сервисного токена ВК — 3 запроса в секунду на всё приложение.
OnCalendar=*:0/30

# Разброс, чтобы прогон не приходился ровно на круглое время: у соседей на этом
# же боксе свои задания по расписанию, и одновременный старт бьёт по
# единственному vCPU.
RandomizedDelaySec=300

# Persistent НЕ включаем. При интервале в полчаса догонять нечего: пропущенный
# прогон возьмёт те же записи через 30 минут. А включённый Persistent ставит
# догоняющий запуск сразу при активации таймера — то есть при загрузке бокса,
# когда приложение ещё поднимается; OnBootSec его не сдерживает, и каждый ребут
# выглядел бы в журнале как отказ импорта.
Persistent=false

# Первый запуск не в момент старта системы: приложению нужно подняться.
# Обёртка запуска дополнительно переживает отказ соединения ретраями.
OnBootSec=10min

[Install]
WantedBy=timers.target
