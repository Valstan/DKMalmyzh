# ─────────────────────────────────────────────────────────────────────────────
# Малмыжский районный Центр культуры и досуга — пример переменных окружения.
#
# ⚠️ Это ШАБЛОН. Реальные значения НЕ коммитим (pool #008 «секреты вне репо»).
#   • Локально:  скопировать в web/.env и подставить значения (web/.env в .gitignore).
#   • На проде:  секреты живут в /etc/dkmalmyzh/dkmalmyzh.env (root:0640) и
#                подключаются systemd-юнитом через EnvironmentFile=, НЕ в дереве репо.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL. Локально (Windows + системный Postgres): postgres/postgres.
DATABASE_URI=

# Payload auth secret (шифрует JWT). На проде — длинная случайная строка.
PAYLOAD_SECRET=

# Публичный URL сервера (без хвостового слэша).
NEXT_PUBLIC_SERVER_URL=https://культура.вмалмыже.рф

# Порт приложения. Прод-юнит читает PORT из /etc/dkmalmyzh/dkmalmyzh.env;
# Next standalone (server.js) уважает PORT. Локально по умолчанию тоже 3005.
PORT=3005

# ─── Аналитика: Яндекс.Метрика (D-017) ───────────────────────────────────────
# Номер счётчика. Пусто → тег не рендерится вовсе (локально и в превью статистику
# прода не пачкаем). Боевое значение — в vars.NEXT_PUBLIC_YANDEX_METRICA_ID.
# NEXT_PUBLIC_YANDEX_METRICA_ID=111459038

# Показывать ли видимый информер посещаемости в подвале. Ставить '1' только
# ПОСЛЕ того, как в кабинете счётчика включена настройка «Информер» и картинка
# проверена глазами: при выключенной настройке сервис отдаёт валидный PNG
# с нулями, и подвал выглядит сломанным, а не выключенным.
# NEXT_PUBLIC_METRIKA_INFORMER=1

# ⚠️ Оба NEXT_PUBLIC_* бейкаются в бандл ПРИ СБОРКЕ — смена значения требует
# пересборки и передеплоя, рестарта юнита недостаточно.

# ─── SMTP-relay для исходящих писем (опционально) ─────────────────────────────
# Пока SMTP_HOST пуст — email-адаптер в payload.config НЕ подключается, письма
# пишутся в консоль; сборка/типы при этом зелёные. Чтобы письма реально уходили,
# заполнить все SMTP_* (на проде — в /etc/dkmalmyzh/dkmalmyzh.env).
#   port 465 → secure=true (implicit TLS), 587/2525 → secure=false (STARTTLS).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_ADDRESS=no-reply@культура.вмалмыже.рф
# SMTP_FROM_NAME=Культура Малмыжского района
# SMTP_SECURE=false

# Прод (IDN культура.вмалмыже.рф → punycode; именно это значение стоит в
# vars.NEXT_PUBLIC_SERVER_URL и бейкается в бандл при сборке в CI):
# NEXT_PUBLIC_SERVER_URL=https://xn--80atdujec4e.xn--80adkdyec4j.xn--p1ai
#
# Прежний домен домкультуры.вмалмыже.рф (xn--d1amdcjpngc5fh.xn--80adkdyec4j.xn--p1ai)
# отдаёт 301 на раздел РЦКД портала. В NEXT_PUBLIC_SERVER_URL его ставить нельзя:
# из этого значения строятся каноникалы и sitemap.

# ─── Импорт из сообществ ВКонтакте через шлюз SARAFAN (только прод) ───────────
# В ВК ходим ТОЛЬКО через шлюз проекта setka (SARAFAN), никогда напрямую. Это
# правило экосистемы, а не наше предпочтение: VK привязывает user-токен к IP
# выпуска, поэтому раздача токена другим проектам технически не работает —
# работает «исполни своим токеном и верни результат». Контракт шлюза —
# setka/docs/GATEWAY.md.
#
# Адрес шлюза. Значения по умолчанию НЕТ намеренно: это хостнейм чужой
# инфраструктуры (в отслеживаемых файлах такие не храним), и он менялся вместе
# с переездом VPS.
# SARAFAN_GATEWAY_URL=

# Ключ нашего проекта у шлюза (GATEWAY_KEY_DKMALMYZH на стороне setka).
# Живёт ТОЛЬКО в /etc/dkmalmyzh/dkmalmyzh.env на боксе.
# SARAFAN_GATEWAY_KEY=

# Секрет для запуска синхронизации: таймер systemd шлёт его заголовком
# x-sync-secret на POST /internal/vk-sync. Пусто → маршрут отвечает 503, то есть
# выключен. Наружу маршрут закрыт ещё и `deny` в nginx-vhost.
# VK_SYNC_SECRET=

# Пауза между вызовами шлюза, мс. По умолчанию 2100 — квота ключа 30 запросов
# в минуту; меньшая пауза упрётся в 429 на первом же десятке учреждений.
# SARAFAN_PACE_MS=2100

# Сколько последних записей забирать со стены за прогон (по умолчанию 20).
# Для первого, исторического захода имеет смысл поднять разово.
# VK_SYNC_COUNT=20

# 1 → импортированные записи публикуются сразу. По умолчанию приезжают
# ЧЕРНОВИКАМИ: материалы чужих учреждений не должны появляться на портале без
# участия редакции.
# VK_SYNC_PUBLISH=
